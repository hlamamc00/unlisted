// Unlisted data model
//
// A recruiter (User) owns roles. Each Role holds the job description, the brief
// read from it, and what the recruiter has taught it (skip rules, answers).
// People are found from public sources (GitHub, and LinkedIn profiles through
// People Data Labs, a licensed data provider) and stored once; a Match
// links a person to a role with a score, the reasons behind it and the
// recruiter's decision. OptOut lists people who asked never to be included.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is what Netlify's functions run.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  company      String?
  /// A link where candidates can book a call (Calendly, Cal.com, Google Calendar...), offered in messages.
  schedulingUrl  String?
  /// Business postal address, added to the footer of emails Unlisted sends for this recruiter.
  mailingAddress String?
  createdAt    DateTime @default(now())
  roles        Role[]
}

model Role {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  jdText       String    @db.Text
  /// The structured brief (see src/lib/brief.ts: Brief).
  brief        Json
  /// Answers to the questions job descriptions leave out: { target, avoid, like, pay }.
  context      Json      @default("{}")
  /// What must not appear: { excludedLocations: string[] (learned from skips), avoidCompanies: string[] }.
  rules        Json      @default("{}")
  /// Which GitHub result pages have been read, per query, so "Find more" moves on.
  searchState  Json      @default("{}")
  lastSearchAt DateTime?
  /// Keep the agent searching every night for this role.
  nightly      Boolean   @default(false)
  /// Questions the agent asked: [{ id, text, change, status: open | yes | no, askedAt }]
  questions    Json      @default("[]")
  /// Lets a hiring manager review the shortlist without an account, until shareExpiresAt.
  shareToken     String?   @unique
  shareExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  matches      Match[]
  runs         AgentRun[]

  @@index([userId])
}

model Person {
  id          String   @id @default(cuid())
  /// Where we first found them: github | linkedin
  source      String   @default("github")
  githubLogin String?  @unique
  /// "linkedin.com/in/<name>", lowercase (see src/lib/linkedin.ts)
  linkedinUrl String?  @unique
  /// People Data Labs' id for the person, when found through it
  pdlId       String?  @unique
  /// Current job title
  headline    String?
  name        String?
  avatarUrl   String?
  location    String?
  bio         String?
  company     String?
  blog        String?
  email       String?
  hireable    Boolean?
  followers   Int      @default(0)
  /// True when they have a LinkedIn profile we know of (linked from GitHub, or found on LinkedIn).
  hasLinkedIn Boolean  @default(false)
  /// Skills listed on their professional profile
  skills      Json     @default("[]")
  /// Recent roles: [{ title, company, current }]
  experience  Json     @default("[]")
  /// { [language]: number of owned repositories }
  languages   Json     @default("{}")
  /// Top owned repositories: [{ name, description, stars, language, topics, pushedAt, url }]
  topRepos    Json     @default("[]")
  totalStars  Int      @default(0)
  lastPushAt  DateTime?
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  matches     Match[]
}

model Match {
  id         String   @id @default(cuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  score      Int
  /// How the person measures against each line of the brief (see src/lib/score.ts: Check).
  checks     Json     @default("[]")
  /// review | approved | skipped
  status     String   @default("review")
  skipReason String?
  draft      String?  @db.Text
  /// search | agent | pool (found earlier, for another role) | you (added by the recruiter)
  foundBy    String   @default("search")
  /// The agent's note: { why, opener, evidence: string[] }
  note       Json?
  /// For approved people (see src/lib/pipeline.ts): new | contacted | replied | interviewing | offer | hired | closed
  stage       String    @default("new")
  contactedAt DateTime?
  /// The recruiter's private notes
  notes       String?   @db.Text
  /// Hiring manager feedback from the shared shortlist: [{ by, verdict: up | down, comment, at }]
  feedback    Json      @default("[]")
  messages    Message[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roleId, personId])
  @@index([roleId, status])
}

/// A message to a candidate: emailed by Unlisted, or sent by the recruiter themselves and logged.
model Message {
  id      String   @id @default(cuid())
  matchId String
  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// first | followup
  kind    String   @default("first")
  /// email (sent by Unlisted) | manual (the recruiter sent it themselves)
  channel String
  subject String?
  body    String   @db.Text
  sentAt  DateTime @default(now())

  @@index([matchId])
}

model OptOut {
  id          String   @id @default(cuid())
  githubLogin String?  @unique
  linkedinUrl String?  @unique
  createdAt   DateTime @default(now())
}

/// One run of the sourcing agent for a role, started by the recruiter or by the nightly top-up.
model AgentRun {
  id         String    @id @default(cuid())
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// manual | nightly
  trigger    String    @default("manual")
  /// queued | running | done | failed
  status     String    @default("queued")
  /// What it's doing now, shown live on the role page.
  progress   String    @default("Starting")
  /// Recent steps, oldest first: [{ at, text }]
  steps      Json      @default("[]")
  /// What it has used, checked against its limits: { toolCalls, lookups, pdlProfiles, githubSearches }
  usage      Json      @default("{}")
  added      Int       @default(0)
  looked     Int       @default(0)
  summary    String?   @db.Text
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([roleId, createdAt])
}
