# Copy to .env for local development. In production, set these in Netlify:
# Site configuration -> Environment variables.

# Postgres. On Neon, use the pooled connection string ("-pooler" in the host).
DATABASE_URL="postgresql://user:password@localhost:5432/unlisted"
# Optional: Neon's direct (unpooled) connection, used for schema changes at build time.
# DATABASE_URL_UNPOOLED=""

# Signs login cookies. At least 32 random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=""

# Claude reads job descriptions and drafts messages. Without it, a simpler keyword reader is used.
ANTHROPIC_API_KEY=""

# GitHub personal access token (no scopes needed, public data only). Without it GitHub allows
# only a handful of searches per hour.
GITHUB_TOKEN=""

# The site's public address, used in links inside messages (for example the opt-out link).
APP_URL="http://localhost:3000"

# Shown on the privacy page as the address people write to about their data.
PRIVACY_EMAIL=""
